{
  "screen": {
    "width": 854,
    "height": 480,
    "fullscreen": true,
    "maximize_apps": true
  },
  "theme": {
    "bg_color": "#0c0914",
    "bg_gradient": "#1a102c",
    "tile_bg": "#221738",
    "tile_border": "#7c3aed",
    "tile_glow": "#ffd60a",
    "tile_text": "#f3e8ff",
    "accent": "#9333ea",
    "font": "Sans",
    "wallpaper": "builtin:comic"
  },
  "grid": {
    "tile_width": 116,
    "tile_height": 108,
    "spacing_x": 26,
    "spacing_y": 40,
    "columns": 5,
    "rows": 2,
    "gutter": 8
  },
  "style": {
    "radius": 3,
    "padding": 14,
    "border_style": "ink",
    "border_width": 3.5,
    "fill": "halftone",
    "shadow": "hard",
    "label": "inside",
    "icon_scale": 1.0,
    "font_size": 12.5,
    "bg": "#7c3aed",
    "border": "#0b0712",
    "text": "#fff4d6"
  },
  "gamepad": {
    "device_auto": true,
    "preferred_device": "/dev/input/event0",
    "layout": "auto"
  },
