  "binds": {
    "HOME": "home",
    "HOME+LEFT": "focus_prev",
    "HOME+RIGHT": "focus_next",
    "HOME+X": "close",
    "HOME+L": "workspace_prev",
    "HOME+R": "workspace_next",
    "HOME+Y": "toggle_tile",
    "HOME+ZL": "move_prev",
    "HOME+ZR": "move_next",
    "HOME+UP": "home_grid",
    "HOME+DOWN": "recents",
    "HOME+q": "close",
    "HOME+t": "toggle_tile",
    "HOME+Return": "exec foot",
    "HOME+1": "workspace 1",
    "HOME+2": "workspace 2",
    "HOME+3": "workspace 3",
    "HOME+4": "workspace 4"
  },
  "windows": {
    "workspaces": 4,
    "tile_new_windows": false,
    "tile_gap": 6
  }
